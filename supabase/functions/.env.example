# Kunci DOKU untuk Edge Functions. JANGAN diisi di Vercel dan jangan di-commit.
# Isi di Supabase → Edge Functions → Secrets (atau: supabase secrets set --env-file supabase/functions/.env).

# DOKU Back Office → Integration → API Keys
DOKU_CLIENT_ID=BRN-0000-0000000000000
DOKU_SECRET_KEY=
# Private key RSA milikmu (pasangan dari Merchant Public Key yang diunggah ke DOKU).
# Tempel utuh termasuk baris BEGIN/END. Di berkas .env, tulis dalam satu baris dengan \n sebagai ganti baris baru.
DOKU_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# DOKU Back Office → Settings → Checkout Appearance → Pengaturan Kredensial QRIS (angka pendek, bukan NMID/MPAN)
DOKU_MERCHANT_ID=
DOKU_TERMINAL_ID=A01
# Kode pos lokasi usaha (5 angka), wajib dikirim ke DOKU.
DOKU_POSTAL_CODE=

# Opsional ------------------------------------------------------------
# Produksi adalah bawaan. Untuk sandbox: https://api-sandbox.doku.com
# DOKU_BASE_URL=https://api.doku.com
# Berapa menit satu kode QR boleh dibayar (bawaan 5).
# DOKU_QR_MINUTES=5
# Isi "off" kalau DOKU menolak pembuatan QR karena kolom validityPeriod.
# DOKU_SEND_VALIDITY=on
