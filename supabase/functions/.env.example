# Secret untuk Edge Functions. JANGAN diisi di Vercel dan jangan di-commit.
# Isi di Supabase → Edge Functions → Secrets (atau: supabase secrets set --env-file supabase/functions/.env).

# Kunci induk yang mengenkripsi kunci DOKU tiap franchise (yang mereka isi di dashboard). Wajib.
# Buat sekali:  supabase secrets set SECRETS_KEY="$(openssl rand -base64 32)"
# Jangan diganti setelah ada franchise yang menyimpan kunci.
SECRETS_KEY=

# --- Opsional: kunci DOKU lama untuk SATU franchise --------------------------------------
# Tiap franchise mengisi kunci DOKU-nya sendiri di dashboard → Pengaturan → Cara bayar. Kunci di bawah
# ini hanya dipakai untuk franchise dengan id di DOKU_ENV_FRANCHISE, selama ia belum menyimpan kuncinya sendiri.
DOKU_ENV_FRANCHISE=

# DOKU Back Office → Integration → API Keys
DOKU_CLIENT_ID=BRN-0000-0000000000000
DOKU_SECRET_KEY=
# Private key RSA milikmu (pasangan dari Merchant Public Key yang diunggah ke DOKU).
# Tempel utuh termasuk baris BEGIN/END. Di berkas .env, tulis dalam satu baris dengan \n sebagai ganti baris baru.
DOKU_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# DOKU Back Office → Settings → Checkout Appearance → Pengaturan Kredensial QRIS (angka pendek, bukan NMID/MPAN)
DOKU_MERCHANT_ID=
DOKU_TERMINAL_ID=A01
# Kode pos lokasi usaha (5 angka), wajib dikirim ke DOKU.
DOKU_POSTAL_CODE=

# Opsional ------------------------------------------------------------
# Produksi adalah bawaan. Untuk sandbox: https://api-sandbox.doku.com
# DOKU_BASE_URL=https://api.doku.com
# Berapa menit satu kode QR boleh dibayar (bawaan 5).
# DOKU_QR_MINUTES=5
# Isi "off" kalau DOKU menolak pembuatan QR karena kolom validityPeriod.
# DOKU_SEND_VALIDITY=on

# Cloudflare R2, untuk hasil foto yang diunduh tamu lewat QR (lihat README).
# Cloudflare → R2 → Overview: Account ID. Manage R2 API Tokens: Access Key ID dan Secret Access Key.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hello-snaply-hasil
