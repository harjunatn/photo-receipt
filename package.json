  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^24.0.0",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
